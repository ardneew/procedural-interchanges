<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ManagedPath Condition="'$(ManagedPath)' == ''">$(CSII_MANAGEDPATH)</ManagedPath>
    <ManagedPath Condition="'$(ManagedPath)' == ''">C:\Users\liand\Downloads\Cities-Skylines-2-SteamRIP.com\Cities Skylines II\Cities2_Data\Managed</ManagedPath>
    <NoWarn>$(NoWarn);CS1591;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Systems\HighwayPrefabCatalogSystem.cs" Link="Systems\HighwayPrefabCatalogSystem.cs" />
    <Compile Include="..\ProceduralInterchanges.Tests\Fixtures\**\*.cs" Link="Fixtures\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\ProceduralInterchanges.Tests\Audit\**\*.cs" Link="Audit\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Unity.Mathematics"><HintPath>$(ManagedPath)\Unity.Mathematics.dll</HintPath></Reference>
    <Reference Include="Colossal.Mathematics"><HintPath>$(ManagedPath)\Colossal.Mathematics.dll</HintPath></Reference>
    <Reference Include="Colossal.Collections"><HintPath>$(ManagedPath)\Colossal.Collections.dll</HintPath></Reference>
    <Reference Include="Colossal.Core"><HintPath>$(ManagedPath)\Colossal.Core.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="Unity.Entities"><HintPath>$(ManagedPath)\Unity.Entities.dll</HintPath></Reference>
    <Reference Include="Unity.Collections"><HintPath>$(ManagedPath)\Unity.Collections.dll</HintPath></Reference>
    <Reference Include="Game"><HintPath>$(ManagedPath)\Game.dll</HintPath></Reference>
  </ItemGroup>
</Project>
